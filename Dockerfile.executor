# Secure Docker container for code execution
FROM ubuntu:22.04

# Install compilers and runtime environments
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    python3 \
    python3-pip \
    openjdk-17-jdk \
    nodejs \
    npm \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user for code execution
RUN useradd -m -s /bin/bash coderunner
RUN mkdir -p /app/temp && chown coderunner:coderunner /app/temp

# Set resource limits
RUN echo "coderunner soft nproc 10" >> /etc/security/limits.conf
RUN echo "coderunner hard nproc 10" >> /etc/security/limits.conf
RUN echo "coderunner soft nofile 100" >> /etc/security/limits.conf
RUN echo "coderunner hard nofile 100" >> /etc/security/limits.conf

# Disable network access for code execution
RUN echo "net.ipv4.ip_forward = 0" >> /etc/sysctl.conf

# Copy executor files
COPY server/secure-executor.js /app/
COPY package*.json /app/
WORKDIR /app

# Install dependencies
RUN npm install --production

# Switch to non-root user
USER coderunner

# Expose port
EXPOSE 3003

# Start secure executor
CMD ["node", "secure-executor.js"]